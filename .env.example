# 环境变量示例。程序不自动加载 .env；复制文件后仍需由 shell/部署系统注入。
# .env 已被 .gitignore 排除；正式 systemd 使用 /etc/onisoul/server.env 的 EnvironmentFile。

# ---- HTTP ----
STUB_HOST=127.0.0.1
STUB_PORT=18080
AUTH_MODE=strict
# Empty disables debug/devLogin and debug/debugLogin; never leave them open on a public server.
STUB_DEBUG_LOGIN_KEY=

# ---- MySQL ----
# 库与账号在服务器本地建账（仅监听 127.0.0.1），密码不写进代码仓库。
ONI_DB_HOST=127.0.0.1
ONI_DB_PORT=3306
ONI_DB_NAME=game_db
ONI_DB_USER=game_app
ONI_DB_PASSWORD=CHANGE_ME

# ---- 目录（留空则按代码内相对路径默认值）----
ONI_ROOT=
ONI_CONFIG_DIR=
ONI_DATA_DIR=
ONI_LOG_DIR=
ONI_PC_WEB_DIR=
ONI_PC_BUNDLE_DIR=
ONI_PC_CACHE_DIR=
ONI_TABLE_DIR=
# 例如：ONI_PC_WEB_DIR=E:\oni-soul\work\pcweb
#       ONI_PC_BUNDLE_DIR=E:\oni-soul\work\webclient\assets
#       ONI_PC_CACHE_DIR=E:\oni-soul\work\official_cache\bundles
#       ONI_TABLE_DIR=E:\oni-soul\assets\pc\tables
