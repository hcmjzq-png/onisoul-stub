[Unit]
Description=OniSoul stub server (API + static assets)
After=network.target mysql.service
Requires=mysql.service

[Service]
Type=simple
User=oni
Group=oni
NoNewPrivileges=true
UMask=0077
WorkingDirectory=/srv/onisoul/server
# Required private configuration, owned by root with mode 0600.
EnvironmentFile=/etc/onisoul/server.env
ExecStart=/srv/onisoul/.venv/bin/python -m app.main --host 127.0.0.1 --port 18080
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
