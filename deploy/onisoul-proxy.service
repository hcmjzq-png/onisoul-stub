[Unit]
Description=OniSoul port 80 proxy -> stub 18080
After=network.target onisoul-stub.service
Wants=onisoul-stub.service

[Service]
Type=simple
User=oni
Group=oni
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
UMask=0077
WorkingDirectory=/srv/onisoul/server
Environment=ONI_ROOT=/srv/onisoul/server
Environment=ONI_LOG_DIR=/srv/onisoul/logs/server
ExecStart=/srv/onisoul/.venv/bin/python /srv/onisoul/server/tools/proxy80.py --listen 80 --upstream 18080
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
