# 运行数据、日志与资源包（不入库，服务器本地保留）
data/
logs/

# 资源默认不入库；登录链路素材和仓库维护的兼容页列为例外（见 docs/repro-launcher-login.md）
assets/*
!assets/pc/
assets/pc/*
!assets/pc/web/
assets/pc/web/*
!assets/pc/web/client/
assets/pc/web/client/*
!assets/pc/web/client/app.html
!assets/pc/web/client/app.css
!assets/pc/web/client/js/
!assets/pc/web/client/img/
!assets/pc/web/client/login/
# Authored inbox compatibility page and legacy bridge adapter.
!assets/pc/web/client/inbox/
assets/pc/web/client/inbox/*
!assets/pc/web/client/inbox/inbox.html
!assets/pc/web/client/inbox/inbox-v4.js

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 本地环境变量（含数据库密码，禁止入库）
.env
.env.local
*.env
*.pem
*.key
*.local.json
*.local.ps1
*.local.toml

# 备份与临时文件
*.bak
*.tmp
*.sql-wal

# 反编译工具与临时工作目录（ilspycmd 等二进制禁止入库）
work/

# 系统 / 编辑器
.DS_Store
Thumbs.db
